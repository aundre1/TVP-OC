
# ============================================================
# BACKEND TOGGLE — switches between Railway and Steve's backend
# ============================================================
#
# Option A: Use Vercel proxy (production default)
#   VITE_API_URL=/api
#   Then update vercel.json rewrites destination:
#     Railway (ours):  https://tvp-oc-production.up.railway.app/api/:path*
#     Steve's backend: https://www.thevideopool.com/api/:path*
#
# Option B: Hit backend directly (bypasses vercel.json proxy; needs CORS)
#   Railway: VITE_API_URL=https://tvp-oc-production.up.railway.app/api
#   Steve:   VITE_API_URL=https://www.thevideopool.com/api
#
# Current production value: VITE_API_URL=/api  (set on Vercel dashboard)
VITE_API_URL=/api

# Google reCAPTCHA v3 (invisible, score-based bot protection)
# Get keys at: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here
