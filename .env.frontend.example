# ============================================================
# THE VIDEO POOL - Frontend Environment Variables
# Copy to .env.local and fill in your actual values
#
# FRONTEND ONLY: These are Vite build-time variables
# Vercel will inject these at build time from GitHub Secrets
# ============================================================

# API Integration
# Where to send requests from the browser
# Local dev: http://localhost:5000 (backend running locally)
# Production: https://api.thevideopool.com (your backend API URL)
VITE_API_URL=http://localhost:5000

# Google reCAPTCHA v3
# Get free keys at: https://www.google.com/recaptcha/admin
# This is your SITE KEY (public - safe to expose in frontend)
# Choose reCAPTCHA v3 (invisible, score-based)
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key-here

# Google OAuth (Optional - for social login)
# Get from: https://console.cloud.google.com/
# Project → Credentials → OAuth 2.0 Client ID (Web application)
# This is the CLIENT ID (public - safe to expose in frontend)
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Environment/Build Context
# Vite automatically sets this, but you can override if needed
# Options: development, production, staging
# Default: production (during build)
VITE_ENV=production

# Analytics & Monitoring (Optional)
# Any third-party analytics platforms you want to track events to
# Examples: Segment, Mixpanel, GA4
# VITE_ANALYTICS_KEY=your-analytics-key

# Feature Flags (Optional)
# Use these to enable/disable features at build time
# VITE_ENABLE_DEMO_MODE=false
# VITE_ENABLE_BETA_FEATURES=false

# ============================================================
# IMPORTANT SECURITY NOTES:
# ============================================================
#
# 1. These variables are EXPOSED in the frontend bundle
#    NEVER put secrets here (API keys, tokens, passwords)
#
# 2. Only add variables that START with VITE_
#    Vite only exposes these to your code
#
# 3. In Vercel:
#    - Set these in Project Settings → Environment Variables
#    - They're auto-injected during build
#    - No .env file needed in production
#
# 4. How to use in code:
#    import.meta.env.VITE_API_URL
#    import.meta.env.VITE_RECAPTCHA_SITE_KEY
#
# ============================================================
# DEVELOPMENT vs PRODUCTION
# ============================================================
#
# Local Development (.env.local):
#   - VITE_API_URL=http://localhost:5000
#   - Use local backend
#   - Test features freely
#
# Production (Vercel):
#   - VITE_API_URL=https://api.thevideopool.com
#   - Use production backend
#   - No console logs or debugging
#
# Staging (Optional):
#   - VITE_API_URL=https://api-staging.thevideopool.com
#   - Use staging backend
#   - For testing before production
#
# ============================================================
