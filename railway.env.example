# Railway Environment Variables Template
# Copy to Railway dashboard Variables section

# API Configuration
VITE_API_URL=https://api-staging.thevideopool.com

# Build Environment
NODE_ENV=production

# Logging
VITE_LOG_LEVEL=info

# Feature Flags (JSON format)
VITE_FEATURE_FLAGS={"beta_features":true,"advanced_search":true,"offline_mode":false}

# Analytics (Optional)
VITE_ANALYTICS_ID=your-analytics-id-here
VITE_SENTRY_DSN=your-sentry-dsn-here

# Authentication (if needed)
VITE_AUTH_PROVIDER=google
VITE_STRIPE_PUBLIC_KEY=pk_test_your_key_here

# Performance
VITE_ENABLE_SOURCEMAPS=false
VITE_CHUNK_SIZE_WARNING_LIMIT=500
