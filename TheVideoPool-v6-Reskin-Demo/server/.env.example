# ===========================================
# THE VIDEO POOL - Backend Environment Config
# Copy this to .env and fill in your values
# ===========================================

# Server
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database (PostgreSQL)
DATABASE_URL=postgres://tvp_user:your_password@localhost:5432/thevideopool
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thevideopool
DB_USER=tvp_user
DB_PASSWORD=your_secure_password

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this
REFRESH_TOKEN_EXPIRY=30d

# Stripe Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_MONTHLY=price_monthly_id
STRIPE_PRICE_ANNUAL=price_annual_id
STRIPE_PRICE_LIFETIME=price_lifetime_id

# SendGrid Email
SENDGRID_API_KEY=SG.your_sendgrid_api_key
FROM_EMAIL=noreply@thevideopool.com
FROM_NAME=The Video Pool

# S3/Wasabi Storage
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=tvp-videos
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.wasabisys.com

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3001
