# ============================================================
# THE VIDEO POOL - Backend Environment Variables
# Copy to .env and fill in your actual values
#
# BACKEND ONLY: These are Node.js runtime variables
# Railway will load these from Encrypted Environment Variables
# ============================================================

# ============================================================
# 1. SERVER CONFIGURATION
# ============================================================

# Node environment: development, staging, or production
NODE_ENV=production

# Server port: Railway auto-assigns, but can override
PORT=5000

# Public URL where backend is accessible from frontend
# Frontend makes requests to this URL
# Production: https://api.thevideopool.com (your API domain)
# Staging: https://api-staging.thevideopool.com
# Local: http://localhost:5000
API_URL=http://localhost:5000

# ============================================================
# 2. DATABASE (Supabase PostgreSQL)
# ============================================================

# Full connection string with credentials
# Format: postgres://user:password@host:port/database
# Get from Supabase Dashboard:
#   → Project Settings → Database → URI (Postgres)
DATABASE_URL=postgres://postgres:your_password@localhost:5432/thevideopool

# Individual database components (alternative to DATABASE_URL)
# Some libraries need these separate
DB_HOST=localhost
DB_PORT=5432
DB_NAME=thevideopool
DB_USER=postgres
DB_PASSWORD=your_secure_password

# ============================================================
# 3. AUTHENTICATION - JWT
# ============================================================

# Secret key for signing JWT access tokens
# Generate: openssl rand -hex 32
# CRITICAL: Change this in production, make it very long
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-long

# How long access tokens are valid
# Format: "24h", "7d", "30d"
JWT_EXPIRY=24h

# Secret key for signing refresh tokens
# Generate: openssl rand -hex 32 (different from JWT_SECRET)
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this-make-it-long

# How long refresh tokens are valid
# Longer than JWT_EXPIRY (users can stay logged in without entering password)
REFRESH_TOKEN_EXPIRY=30d

# ============================================================
# 4. STRIPE PAYMENTS (Phase 2 - Not in launch)
# ============================================================

# Get from: https://dashboard.stripe.com/apikeys
# Use RESTRICTED key for security
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_or_sk_live_for_production

# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_from_webhook_endpoint

# Price IDs from Stripe products
# Get from: https://dashboard.stripe.com/products
# These are for different subscription tiers
STRIPE_PRICE_MONTHLY=price_monthly_id_from_stripe
STRIPE_PRICE_ANNUAL=price_annual_id_from_stripe
STRIPE_PRICE_LIFETIME=price_lifetime_id_from_stripe

# ============================================================
# 5. EMAIL (SendGrid or equivalent)
# ============================================================

# Get from: https://app.sendgrid.com/settings/api_keys
# Create API key with Mail Send permission
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Email sender address and name
FROM_EMAIL=noreply@thevideopool.com
FROM_NAME=The Video Pool

# ============================================================
# 6. FILE STORAGE (AWS S3 or Wasabi)
# ============================================================

# S3-compatible storage (AWS, Wasabi, DigitalOcean Spaces, etc.)
# For now, we use Wasabi (cheaper than AWS S3)

# Get from: S3 console or Wasabi dashboard
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# S3 bucket name where videos/files are stored
S3_BUCKET=tvp-videos

# AWS region (for AWS S3) or Wasabi region
# Wasabi regions: us-east-1, us-west-1, eu-west-1, etc.
S3_REGION=us-east-1

# S3 endpoint URL
# AWS S3: https://s3.amazonaws.com (default)
# Wasabi: https://s3.wasabisys.com
# DO Spaces: https://nyc3.digitaloceanspaces.com
S3_ENDPOINT=https://s3.wasabisys.com

# S3 bucket URL for serving files publicly
# Format: https://{bucket}.{endpoint}
S3_BUCKET_URL=https://tvp-videos.s3.wasabisys.com

# ============================================================
# 7. CACHING (Redis - Optional)
# ============================================================

# Redis connection string for caching
# Not required for launch, but enables performance optimization
# Get from: Redis Cloud, Railway Redis add-on, or local Redis
REDIS_URL=redis://localhost:6379

# Redis password (if your Redis instance requires auth)
# REDIS_PASSWORD=your_redis_password

# ============================================================
# 8. GOOGLE OAUTH (Optional - Phase 2)
# ============================================================

# OAuth for "Sign in with Google"
# Get from: https://console.cloud.google.com/
# Project → Credentials → OAuth 2.0 Client ID → Web application

# This is the CLIENT SECRET (keep private - don't expose in frontend)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Redirect URL after Google login
# Must match what you configured in Google Cloud Console
GOOGLE_REDIRECT_URI=https://api.thevideopool.com/auth/google/callback

# ============================================================
# 9. CORS & FRONTEND INTEGRATION
# ============================================================

# Frontend URL (for CORS)
# This tells backend to allow requests from this URL
# Local: http://localhost:3001
# Vercel: https://tvp-oc.vercel.app or https://thevideopool.com
FRONTEND_URL=http://localhost:3001

# Allow multiple frontend URLs (comma-separated)
# For staging + production
# FRONTEND_URLS=http://localhost:3001,https://tvp-oc.vercel.app,https://thevideopool.com

# ============================================================
# 10. RATE LIMITING
# ============================================================

# Enable rate limiting (prevent abuse)
ENABLE_RATE_LIMIT=true

# Max requests per window (e.g., 100 requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# 11. LOGGING & MONITORING (Optional)
# ============================================================

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# Sentry error tracking (optional)
# Get from: https://sentry.io/
# SENTRY_DSN=your_sentry_dsn_url

# ============================================================
# 12. SECURITY
# ============================================================

# CORS allowed origins (frontend domains)
# Comma-separated list
CORS_ORIGINS=http://localhost:3001,https://tvp-oc.vercel.app,https://thevideopool.com

# HTTPS only
# Set to true in production (forces secure cookies)
SECURE_COOKIES=false

# CSRF protection enabled
ENABLE_CSRF_PROTECTION=true

# Session secret (for signed cookies)
SESSION_SECRET=your-session-secret-make-this-long-and-random

# ============================================================
# 13. DATABASE MIGRATIONS (Optional)
# ============================================================

# Auto-run migrations on startup
# true = run migrations automatically
# false = manual migrations required
AUTO_MIGRATE=true

# ============================================================
# HOW TO FILL IN THESE VALUES
# ============================================================
#
# 1. Database (Supabase):
#    - Go to supabase.com
#    - Create project
#    - Settings → Database → Copy Connection String
#    - Paste into DATABASE_URL
#
# 2. JWT Secrets:
#    - Generate: openssl rand -hex 32
#    - Make them different
#    - Keep them SECRET
#
# 3. SendGrid:
#    - Go to sendgrid.com
#    - Settings → API Keys → Create key
#    - Copy API key
#
# 4. S3/Wasabi:
#    - Sign up for Wasabi (cheaper than AWS S3)
#    - Create bucket
#    - Generate API keys
#    - Set region and endpoint
#
# 5. Google OAuth:
#    - Go to console.cloud.google.com
#    - Create project
#    - APIs & Services → Credentials
#    - Create OAuth 2.0 Client ID
#    - Download JSON (has client ID and secret)
#
# 6. Stripe (Phase 2):
#    - Go to stripe.com
#    - Settings → API Keys
#    - Copy secret key (starts with sk_)
#
# ============================================================
# VERCEL/RAILWAY SETUP
# ============================================================
#
# For Railway:
#   - Dashboard → Project → Variables → Raw Editor
#   - Paste all these variables (Railway encrypts them)
#   - Click Save
#   - Railway auto-injects into runtime
#
# For Vercel (if using Node.js runtime):
#   - Go to Project Settings → Environment Variables
#   - Add each variable
#   - These don't apply to static frontend (only serverless functions)
#
# ============================================================
