# ============================================================================
# The Video Pool - Supabase Database Connection Template
# ============================================================================
# This file shows the format for your database connection string.
# Use this to configure Railway and your local development environment.
# ============================================================================

# PRODUCTION CONNECTION STRING (for Railway)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
#
# Example (with fake values):
# postgresql://postgres.dxbtycycyvmzgufdhnae:VerySecurePassword123!@db.dxbtycycyvmzgufdhnae.supabase.co:5432/postgres?schema=the_video_pool

DATABASE_URL=postgresql://postgres.dxbtycycyvmzgufdhnae:[YOUR_PASSWORD]@db.dxbtycycyvmzgufdhnae.supabase.co:5432/postgres?schema=the_video_pool

# ============================================================================
# BREAKING DOWN THE CONNECTION STRING
# ============================================================================

# Full Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA

# Parts Explained:

# USER (postgres.dxbtycycyvmzgufdhnae)
#   From Supabase Settings → Database → User
#   Usually: postgres.dxbtycycyvmzgufdhnae

USER=postgres.dxbtycycyvmzgufdhnae

# PASSWORD ([YOUR_PASSWORD])
#   From Supabase Settings → Database → Password field
#   This is the password you set when creating the Supabase project
#   DO NOT commit the real password to git!

PASSWORD=[REPLACE_WITH_YOUR_PASSWORD]

# HOST (db.dxbtycycyvmzgufdhnae.supabase.co)
#   From Supabase Settings → Database → Host
#   Always the same format: db.[PROJECT_ID].supabase.co

HOST=db.dxbtycycyvmzgufdhnae.supabase.co

# PORT (5432)
#   PostgreSQL default port
#   Usually always 5432

PORT=5432

# DATABASE (postgres)
#   The database name
#   Supabase default is "postgres"
#   DO NOT change this

DATABASE=postgres

# SCHEMA (the_video_pool)
#   The schema we created
#   This separates The Video Pool data from other projects
#   MUST include this with ?schema=the_video_pool

SCHEMA=the_video_pool

# ============================================================================
# HOW TO GET THESE VALUES FROM SUPABASE
# ============================================================================

# Step 1: Open Supabase Dashboard
#   → https://supabase.com/dashboard
#   → Select "IncentEdge Grants Database" project

# Step 2: Go to Settings
#   → Left sidebar → Settings
#   → Click "Database" under Configuration

# Step 3: Find Connection String Section
#   You'll see "Connection string" with these options:
#   - URI (what we use)
#   - psql
#   - Python
#   - JavaScript

# Step 4: Click "URI" tab
#   You'll see something like:
#   postgresql://postgres.dxbtycycyvmzgufdhnae:VerySecurePass123!@db.dxbtycycyvmzgufdhnae.supabase.co:5432/postgres

# Step 5: Copy the password
#   The part between the first ":" and first "@"
#   In the example: "VerySecurePass123!"

# ============================================================================
# IMPORTANT: Adding ?schema=the_video_pool
# ============================================================================

# Supabase gives you:
# postgresql://postgres.dxbtycycyvmzgufdhnae:PASSWORD@db.dxbtycycyvmzgufdhnae.supabase.co:5432/postgres

# You MUST add at the end:
# ?schema=the_video_pool

# Final result:
# postgresql://postgres.dxbtycycyvmzgufdhnae:PASSWORD@db.dxbtycycyvmzgufdhnae.supabase.co:5432/postgres?schema=the_video_pool

# This tells PostgreSQL to use the "the_video_pool" schema specifically.
# Without it, it will try to use the default public schema (which has IncentEdge data).

# ============================================================================
# WHERE TO PUT THIS
# ============================================================================

# RAILWAY ENVIRONMENT VARIABLES:
# 1. Go to Railway dashboard
# 2. Select The Video Pool project
# 3. Click on the app service
# 4. Go to Variables tab
# 5. Add/update: DATABASE_URL=[full connection string]
# 6. Click Save

# LOCAL DEVELOPMENT (.env or .env.local):
# If you want to test locally, create a .env file with:
# DATABASE_URL=postgresql://postgres.dxbtycycyvmzgufdhnae:PASSWORD@db.dxbtycycyvmzgufdhnae.supabase.co:5432/postgres?schema=the_video_pool

# ============================================================================
# SECURITY NOTES
# ============================================================================

# DO NOT:
# ✗ Commit the password to git
# ✗ Share the connection string publicly
# ✗ Put real passwords in code

# DO:
# ✓ Use environment variables (DATABASE_URL in Railway)
# ✓ Keep passwords in .env files (added to .gitignore)
# ✓ Rotate passwords regularly in Supabase
# ✓ Use Supabase's built-in security features

# ============================================================================
# TESTING THE CONNECTION
# ============================================================================

# Once you've set DATABASE_URL in Railway, you can test with:
#
# Option 1: Using psql (PostgreSQL CLI)
# psql "postgresql://postgres.dxbtycycyvmzgufdhnae:PASSWORD@db.dxbtycycyvmzgufdhnae.supabase.co:5432/postgres?schema=the_video_pool" -c "SELECT COUNT(*) FROM videos;"
#
# Option 2: In Node.js code
# const { Pool } = require('pg');
# const pool = new Pool({ connectionString: process.env.DATABASE_URL });
# const res = await pool.query('SELECT COUNT(*) FROM videos;');
# console.log(res.rows);
#
# Option 3: Using Drizzle ORM (what The Video Pool uses)
# It will automatically use the DATABASE_URL environment variable

# ============================================================================
# REFERENCE
# ============================================================================

# Connection String Components Reference:
# postgresql://
#   └─ Protocol (always this for PostgreSQL)
#
# postgres.dxbtycycyvmzgufdhnae
#   └─ Username (from Supabase)
#
# :VerySecurePassword123!
#   └─ Password (between : and @)
#
# @db.dxbtycycyvmzgufdhnae.supabase.co
#   └─ Host (Supabase server)
#
# :5432
#   └─ Port (PostgreSQL default)
#
# /postgres
#   └─ Database name (in Supabase, always "postgres")
#
# ?schema=the_video_pool
#   └─ Schema (isolates The Video Pool data)

# ============================================================================
